+"""Built-in Niimbot label editor sidebar panel."""

+

+from __future__ import annotations

+

+import base64

+import io

+from dataclasses import dataclass

+from datetime import UTC, datetime

+from pathlib import Path

+from typing import Any

+

+import voluptuous as vol

+from homeassistant.components import bluetooth, websocket_api

+from homeassistant.components.frontend import async_register_built_in_panel, async_remove_panel

+from homeassistant.components.http import StaticPathConfig

+from homeassistant.components.image import Image as HAImage

+from homeassistant.config_entries import ConfigEntry

+from homeassistant.core import HomeAssistant

+from homeassistant.exceptions import HomeAssistantError

+from homeassistant.helpers import config_validation as cv

+from homeassistant.util import slugify

+

+from .const import (

+    DOMAIN,

+    EDITOR_PANEL_COMPONENT_NAME,

+    EDITOR_PANEL_ELEMENT_NAME,

+    EDITOR_PANEL_FRONTEND_FILENAME,

+    EDITOR_PANEL_STATIC_URL,

+    EDITOR_PANEL_URL_PATH,

+)

+from .editor_store import TemplateStore

+from .imagegen import customimage

+

+

+@dataclass(slots=True)

+class _RenderRequest:

+    """Tiny stand-in that exposes .data like a ServiceCall."""

+

+    data: dict[str, Any]

+

+

+def _image_to_data_uri(image_bytes: bytes) -> str:

+    encoded = base64.b64encode(image_bytes).decode("ascii")

+    return f"data:image/png;base64,{encoded}"

+

+

+async def _async_render_image(

+    hass: HomeAssistant,

+    entry_id: str,

+    data: dict[str, Any],

+) -> tuple[Any, bytes, str]:

+    image = await hass.async_add_executor_job(

+        customimage,

+        entry_id,

+        _RenderRequest(data=data),

+        hass,

+    )

+    buffer = io.BytesIO()

+    image.save(buffer, format="PNG")

+    raw = buffer.getvalue()

+    return image, raw, _image_to_data_uri(raw)

+

+

+def _get_template_store(hass: HomeAssistant) -> TemplateStore:

+    store = hass.data[DOMAIN].get("_editor_store")

+    if store is None:

+        store = TemplateStore(hass)

+        hass.data[DOMAIN]["_editor_store"] = store

+    return store

+

+

+def _get_runtime(hass: HomeAssistant, entry_id: str) -> dict[str, Any]:

+    runtime = hass.data.get(DOMAIN, {}).get(entry_id)

+    if runtime is None:

+        raise HomeAssistantError(

+            f"Niimbot entry '{entry_id}' is not loaded. "

+            "Make sure the printer integration is configured and loaded."

+        )

+    return runtime

+

+

+def _get_entry(hass: HomeAssistant, entry_id: str) -> ConfigEntry:

+    entry = hass.config_entries.async_get_entry(entry_id)

+    if entry is None or entry.domain != DOMAIN:

+        raise HomeAssistantError(f"Unknown Niimbot config entry '{entry_id}'.")

+    return entry

+

+

+def _list_fonts(hass: HomeAssistant) -> list[str]:

+    fonts: set[str] = set()

+

+    integration_dir = Path(__file__).resolve().parent

+    for pattern in ("*.ttf", "*.otf"):

+        fonts.update(path.name for path in integration_dir.glob(pattern))

+

+    www_fonts_dir = Path(hass.config.path("www/fonts"))

+    if www_fonts_dir.exists():

+        for pattern in ("*.ttf", "*.otf"):

+            fonts.update(path.name for path in www_fonts_dir.glob(pattern))

+

+    return sorted(fonts)

+

+

+@websocket_api.websocket_command(

+    {

+        vol.Required("type"): "niimbot/editor/list_printers",

+    }

+)

+@websocket_api.async_response

+async def ws_list_printers(

+    hass: HomeAssistant,

+    connection: websocket_api.ActiveConnection,

+    msg: dict[str, Any],

+) -> None:

+    """Return configured Niimbot printers and available fonts."""

+    printers: list[dict[str, Any]] = []

+    for entry in hass.config_entries.async_entries(DOMAIN):

+        printers.append(

+            {

+                "entry_id": entry.entry_id,

+                "title": entry.title,

+                "address": entry.unique_id,

+                "loaded": entry.entry_id in hass.data.get(DOMAIN, {}),

+            }

+        )

+

+    connection.send_result(

+        msg["id"],

+        {

+            "printers": printers,

+            "fonts": _list_fonts(hass),

+        },

+    )

+

+

+@websocket_api.websocket_command(

+    {

+        vol.Required("type"): "niimbot/editor/preview",

+        vol.Required("entry_id"): str,

+        vol.Required("payload"): [dict],

+        vol.Optional("width", default=400): vol.All(vol.Coerce(int), vol.Range(min=10, max=1600)),

+        vol.Optional("height", default=240): vol.All(vol.Coerce(int), vol.Range(min=10, max=1600)),

+        vol.Optional("rotate", default=0): vol.In([0, 90, 180, 270]),

+        vol.Optional("density", default=3): vol.All(vol.Coerce(int), vol.Range(min=1, max=5)),

+    }

+)

+@websocket_api.async_response

+async def ws_preview(

+    hass: HomeAssistant,

+    connection: websocket_api.ActiveConnection,

+    msg: dict[str, Any],

+) -> None:

+    """Render a preview image for the editor."""

+    try:

+        _get_runtime(hass, msg["entry_id"])

+        _, raw, data_uri = await _async_render_image(

+            hass,

+            msg["entry_id"],

+            {

+                "payload": msg["payload"],

+                "width": msg["width"],

+                "height": msg["height"],

+                "rotate": msg["rotate"],

+                "density": msg["density"],

+                "preview": True,

+            },

+        )

+    except Exception as err:  # noqa: BLE001

+        connection.send_error(msg["id"], "preview_failed", str(err))

+        return

+

+    connection.send_result(

+        msg["id"],

+        {

+            "image": data_uri,

+            "size": {"bytes": len(raw)},

+        },

+    )

+

+

+@websocket_api.websocket_command(

+    {

+        vol.Required("type"): "niimbot/editor/print",

+        vol.Required("entry_id"): str,

+        vol.Required("payload"): [dict],

+        vol.Optional("width", default=400): vol.All(vol.Coerce(int), vol.Range(min=10, max=1600)),

+        vol.Optional("height", default=240): vol.All(vol.Coerce(int), vol.Range(min=10, max=1600)),

+        vol.Optional("rotate", default=0): vol.In([0, 90, 180, 270]),

+        vol.Optional("density", default=3): vol.All(vol.Coerce(int), vol.Range(min=1, max=5)),

+        vol.Optional("wait_between_print_lines", default=0.05): vol.Coerce(float),

+        vol.Optional("print_line_batch_size", default=1): vol.All(vol.Coerce(int), vol.Range(min=1, max=512)),

+    }

+)

+@websocket_api.async_response

+async def ws_print(

+    hass: HomeAssistant,

+    connection: websocket_api.ActiveConnection,

+    msg: dict[str, Any],

+) -> None:

+    """Render and print a label."""

+    try:

+        entry = _get_entry(hass, msg["entry_id"])

+        runtime = _get_runtime(hass, msg["entry_id"])

+

+        image, raw, data_uri = await _async_render_image(

+            hass,

+            msg["entry_id"],

+            {

+                "payload": msg["payload"],

+                "width": msg["width"],

+                "height": msg["height"],

+                "rotate": msg["rotate"],

+                "density": msg["density"],

+            },

+        )

+

+        ble_device = bluetooth.async_ble_device_from_address(hass, entry.unique_id)

+        if ble_device is None:

+            raise HomeAssistantError(

+                f"Could not find printer with address {entry.unique_id} through Home Assistant Bluetooth."

+            )

+

+        result = await runtime["device"].print_image(

+            ble_device,

+            image,

+            density=msg["density"],

+            wait_between_print_lines=msg["wait_between_print_lines"],

+            print_line_batch_size=msg["print_line_batch_size"],

+        )

+

+        image_coordinator = runtime.get("image_coordinator")

+        coordinator = runtime.get("coordinator")

+        if image_coordinator is not None and coordinator is not None:

+            image_coordinator.async_set_updated_data(

+                (

+                    HAImage(content_type="image/png", content=raw),

+                    coordinator.data,

+                )

+            )

+

+        connection.send_result(

+            msg["id"],

+            {

+                "image": data_uri,

+                "result": result,

+            },

+        )

+    except Exception as err:  # noqa: BLE001

+        connection.send_error(msg["id"], "print_failed", str(err))

+

+

+@websocket_api.websocket_command(

+    {

+        vol.Required("type"): "niimbot/editor/list_templates",

+    }

+)

+@websocket_api.async_response

+async def ws_list_templates(

+    hass: HomeAssistant,

+    connection: websocket_api.ActiveConnection,

+    msg: dict[str, Any],

+) -> None:

+    """List saved templates."""

+    templates = await _get_template_store(hass).list_templates()

+    connection.send_result(msg["id"], {"templates": templates})

+

+

+@websocket_api.websocket_command(

+    {

+        vol.Required("type"): "niimbot/editor/save_template",

+        vol.Required("name"): cv.string,

+        vol.Required("label"): dict,

+        vol.Required("payload"): [dict],

+    }

+)

+@websocket_api.async_response

+async def ws_save_template(

+    hass: HomeAssistant,

+    connection: websocket_api.ActiveConnection,

+    msg: dict[str, Any],

+) -> None:

+    """Save a template."""

+    name = msg["name"].strip()

+    if not name:

+        connection.send_error(msg["id"], "invalid_name", "Template name cannot be empty.")

+        return

+

+    safe_name = name[:100]

+    await _get_template_store(hass).save_template(

+        safe_name,

+        label=msg["label"],

+        payload=msg["payload"],

+        updated_at=datetime.now(UTC).isoformat(),

+    )

+    connection.send_result(msg["id"], {"ok": True, "slug": slugify(safe_name)})

+

+

+@websocket_api.websocket_command(

+    {

+        vol.Required("type"): "niimbot/editor/delete_template",

+        vol.Required("name"): cv.string,

+    }

+)

+@websocket_api.async_response

+async def ws_delete_template(

+    hass: HomeAssistant,

+    connection: websocket_api.ActiveConnection,

+    msg: dict[str, Any],

+) -> None:

+    """Delete a template."""

+    await _get_template_store(hass).delete_template(msg["name"])

+    connection.send_result(msg["id"], {"ok": True})

+

+

+async def async_setup_editor(hass: HomeAssistant) -> None:

+    """Register static assets, panel, and websocket commands."""

+    if hass.data[DOMAIN].get("_editor_panel_registered"):

+        return

+

+    frontend_dir = Path(__file__).resolve().parent / "frontend"

+    await hass.http.async_register_static_paths(

+        [StaticPathConfig(EDITOR_PANEL_STATIC_URL, str(frontend_dir), cache_headers=False)]

+    )

+

+    async_register_built_in_panel(

+        hass,

+        component_name=EDITOR_PANEL_COMPONENT_NAME,

+        sidebar_title="Niimbot Editor",

+        sidebar_icon="mdi:label-outline",

+        frontend_url_path=EDITOR_PANEL_URL_PATH,

+        config={

+            "_panel_custom": {

+                "name": EDITOR_PANEL_ELEMENT_NAME,

+                "js_url": f"{EDITOR_PANEL_STATIC_URL}/{EDITOR_PANEL_FRONTEND_FILENAME}",

+                "embed_iframe": False,

+                "trust_external": False,

+            }

+        },

+        require_admin=False,

+    )

+

+    websocket_api.async_register_command(hass, ws_list_printers)

+    websocket_api.async_register_command(hass, ws_preview)

+    websocket_api.async_register_command(hass, ws_print)

+    websocket_api.async_register_command(hass, ws_list_templates)

+    websocket_api.async_register_command(hass, ws_save_template)

+    websocket_api.async_register_command(hass, ws_delete_template)

+

+    hass.data[DOMAIN]["_editor_panel_registered"] = True

+

+

+async def async_unload_editor(hass: HomeAssistant) -> None:

+    """Remove the sidebar panel when the last printer unloads."""

+    if not hass.data.get(DOMAIN, {}).get("_editor_panel_registered"):

+        return

+

+    async_remove_panel(hass, EDITOR_PANEL_URL_PATH)

+    hass.data[DOMAIN]["_editor_panel_registered"] = False

