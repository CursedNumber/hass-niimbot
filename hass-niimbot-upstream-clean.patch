+class NiimbotLabelEditorPanel extends HTMLElement {

+  constructor() {

+    super();

+    this.attachShadow({ mode: "open" });

+    this._hass = null;

+    this._booted = false;

+    this._drag = null;

+    this._previewTimer = null;

+

+    this.state = {

+      printers: [],

+      fonts: [],

+      templates: [],

+      selectedPrinter: "",

+      width: 400,

+      height: 240,

+      rotate: 0,

+      density: 3,

+            payload: [],

+      selectedIndex: -1,

+      previewImage: "",

+      yamlText: "",

+      busy: false,

+      printing: false,

+      error: "",

+      info: "",

+      lastSavedTemplate: "",

+    };

+  }

+

+  set hass(hass) {

+    this._hass = hass;

+    if (!this._booted && hass) {

+      this._booted = true;

+      this._bootstrap();

+    }

+    this.render();

+  }

+

+  set panel(panel) { this._panel = panel; }

+  set narrow(narrow) { this._narrow = narrow; }

+  set route(route) { this._route = route; }

+  connectedCallback() { this.render(); }

+  disconnectedCallback() {

+    window.removeEventListener("mousemove", this._boundMouseMove);

+    window.removeEventListener("mouseup", this._boundMouseUp);

+  }

+

+  async _bootstrap() {

+    try {

+      const printerResp = await this._hass.callWS({ type: "niimbot/editor/list_printers" });

+      const templateResp = await this._hass.callWS({ type: "niimbot/editor/list_templates" });

+      this.state.printers = printerResp.printers || [];

+      this.state.fonts = printerResp.fonts || [];

+      this.state.templates = templateResp.templates || [];

+      if (!this.state.selectedPrinter && this.state.printers.length) {

+        const loaded = this.state.printers.find((p) => p.loaded) || this.state.printers[0];

+        this.state.selectedPrinter = loaded.entry_id;

+      }

+      this._ensureDefaultContent();

+      this._refreshYaml();

+      if (this.state.selectedPrinter) this._schedulePreview(0);

+      this.render();

+    } catch (err) {

+      this.state.error = this._friendlyError(err);

+      this.render();

+    }

+  }

+

+  _ensureDefaultContent() {

+    if (this.state.payload.length) return;

+    const font = this.state.fonts[0] || "ppb.ttf";

+    this.state.payload = [

+      { type: "text", value: "Hello Niimbot", x: 20, y: 26, size: 36, font, color: "black" },

+      { type: "rectangle", x_start: 16, y_start: 56, x_end: 240, y_end: 120, width: 2, outline: "black", fill: "white" },

+      { type: "qrcode", x: 270, y: 20, data: "https://www.home-assistant.io", boxsize: 2, border: 1, color: "black", bgcolor: "white" },

+    ];

+    this.state.selectedIndex = 0;

+  }

+

+  _friendlyError(err) {

+    if (!err) return "Unknown error";

+    if (typeof err === "string") return err;

+    if (err.message) return err.message;

+    return JSON.stringify(err);

+  }

+

+  _deepClone(obj) { return JSON.parse(JSON.stringify(obj)); }

+  _schedulePreview(delay = 350) { clearTimeout(this._previewTimer); this._previewTimer = window.setTimeout(() => this._preview(), delay); }

+

+  async _preview() {

+    if (!this._hass || !this.state.selectedPrinter) return;

+    this.state.busy = true; this.state.error = ""; this.render();

+    try {

+      const resp = await this._hass.callWS({

+        type: "niimbot/editor/preview",

+        entry_id: this.state.selectedPrinter,

+        width: Number(this.state.width),

+        height: Number(this.state.height),

+        rotate: Number(this.state.rotate),

+        density: Number(this.state.density),

+        payload: this.state.payload,

+      });

+      this.state.previewImage = resp.image || "";

+      this.state.busy = false;

+      this._refreshYaml();

+      this.render();

+    } catch (err) {

+      this.state.busy = false;

+      this.state.error = this._friendlyError(err);

+      this.render();

+    }

+  }

